FISCAL_ENVIRONMENT=local
FISCAL_DATABASE_URL=postgresql+asyncpg://fiscal:fiscal@localhost:5432/fiscal
# Set FISCAL_TOKEN_PEPPER to a long random secret outside source control.
FISCAL_TOKEN_PEPPER=replace-with-a-long-random-pepper
FISCAL_LOG_LEVEL=INFO
FISCAL_SERVICE_NAME=fiscal-api

# Batch commits fail closed until this independent secret is configured. Keep
# it identical to the MCP process secret only when commit:imports is enabled.
# Never commit a real value.
FISCAL_IMPORT_CONFIRMATION_SECRET=replace-with-a-different-random-secret
