# Copy to Backend/ops/staging.env and replace every CHANGE_ME value.
# Never commit Backend/ops/staging.env.

FISCAL_DOMAIN=fiscal-staging.example.com
ACME_EMAIL=CHANGE_ME@example.com
FISCAL_IMAGE_TAG=staging

POSTGRES_DB=fiscal
POSTGRES_USER=fiscal
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# The API refuses authenticated key startup with a short pepper. The batch
# confirmation secret is only required when commit:imports is enabled.
FISCAL_TOKEN_PEPPER=CHANGE_ME_USE_A_LONG_RANDOM_TOKEN_PEPPER
FISCAL_IMPORT_CONFIRMATION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_IMPORT_CONFIRMATION_SECRET

# Initialize the personal access passphrase with the CLI before starting a
# staging API; the service requires its resulting credential row.
