[Unit]
Description=Fiscal production API (NB NPM edge)
After=network-online.target postgresql.service docker.service
Wants=network-online.target
Requires=postgresql.service docker.service
OnFailure=fiscal-notify@%n.service

[Service]
Type=simple
User=fiscal
Group=fiscal
WorkingDirectory=/opt/fiscal/current/Backend
EnvironmentFile=/etc/fiscal/fiscal.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# NPM reaches the host through npm_default (172.18.0.0/16). UFW must allow
# 8010 only from that bridge; public 8010 remains denied.
ExecStart=/opt/fiscal/current/Backend/.venv/bin/uvicorn fiscal_api.main:app --host 0.0.0.0 --port 8010 --proxy-headers --forwarded-allow-ips=172.18.0.2
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
