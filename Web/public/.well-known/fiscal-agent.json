{
  "service": "Fiscal",
  "protocol": "MCP over Streamable HTTP",
  "human_url": "https://console.fiscal.linotsai.top/agent/",
  "mcp_endpoint": "https://mcp.fiscal.linotsai.top/mcp",
  "auth": {
    "challenge_endpoint": "https://mcp.fiscal.linotsai.top/auth/challenges",
    "approval_url": "https://console.fiscal.linotsai.top/agent/approve/",
    "poll_method": "GET",
    "poll_header": "X-Fiscal-Poll-Token",
    "session_scheme": "Session",
    "session_idle_seconds": 7200,
    "session_absolute_seconds": 28800,
    "challenge_seconds": 600,
    "challenge_request": {
      "method": "POST",
      "body": {
        "kind": "session | write_window",
        "client_label": "string (optional)",
        "intent": "string (optional, shown publicly on the approval page)",
        "scopes": "array (optional, session only)"
      },
      "response_fields": [
        "challenge_id",
        "poll_token",
        "kind",
        "expires_at",
        "pairing_code",
        "approval_url"
      ],
      "write_window_requires_header": "Authorization: Session <session_token>"
    },
    "poll_url": "https://mcp.fiscal.linotsai.top/auth/challenges/{challenge_id}",
    "poll_response_fields": [
      "challenge_id",
      "kind",
      "status (pending|approved)",
      "expires_at",
      "pairing_code",
      "session_token (session)",
      "write_window_expires_at (write_window)"
    ],
    "restart_invalidates_tokens": true,
    "expired_session": "any /mcp request (initialize, tools/list, ping, tools/call) returns HTTP 401 with error.code=session_expired",
    "approval_flow": "fixed URL; tell the owner the pairing_code to approve; page lists pending requests via GET /auth/challenges/pending",
    "write_window": {
      "scope": "commit:imports",
      "seconds": 1800,
      "bound_to": "requesting session",
      "commit_without_window_error": "write_window_required",
      "covers": [
        "fiscal_commit_import_batch",
        "fiscal_create_account",
        "fiscal_create_category",
        "fiscal_create_cash_flow_item",
        "fiscal_confirm_cash_flow_item",
        "fiscal_settle_cash_flow_item",
        "fiscal_cancel_cash_flow_item",
        "fiscal_create_reimbursement",
        "fiscal_submit_reimbursement",
        "fiscal_record_reimbursement_receipt",
        "fiscal_cancel_reimbursement_outstanding"
      ],
      "requires_session_scope": "stage:imports"
    },
    "pending_limits": {
      "session_per_source": 2,
      "session_total": 20,
      "write_window_per_session": 1
    },
    "never_ask_user_for_codes": true
  },
  "session_scopes": [
    "read:reports",
    "read:ledger",
    "stage:imports",
    "export:reports"
  ],
  "write_scope": "commit:imports",
  "write_requires_fresh_totp": "once per 30-minute write window",
  "personal_break_glass_key": "manual_only",
  "security": {
    "totp": "Google Authenticator compatible 6-digit TOTP; each code is accepted once",
    "secrets_in_document": false,
    "agent_keys": "not_used"
  },
  "tools": [
    "fiscal_get_monthly_report",
    "fiscal_get_yearly_report",
    "fiscal_list_accounts",
    "fiscal_list_categories",
    "fiscal_create_account",
    "fiscal_create_category",
    "fiscal_list_cash_flow_items",
    "fiscal_get_cash_flow_outlook",
    "fiscal_create_cash_flow_item",
    "fiscal_confirm_cash_flow_item",
    "fiscal_settle_cash_flow_item",
    "fiscal_cancel_cash_flow_item",
    "fiscal_list_reimbursements",
    "fiscal_list_reimbursable_expenses",
    "fiscal_create_reimbursement",
    "fiscal_submit_reimbursement",
    "fiscal_record_reimbursement_receipt",
    "fiscal_cancel_reimbursement_outstanding",
    "fiscal_search_ledger",
    "fiscal_create_import_batch",
    "fiscal_get_import_batch",
    "fiscal_validate_import_batch",
    "fiscal_commit_import_batch",
    "fiscal_ignore_import_batch",
    "fiscal_export_report"
  ],
  "amounts": "integer minor units (fen); occurred_at must include a timezone",
  "repayment_cycles": "repayments to fixed-cycle credit accounts require credit_cycle_id from fiscal_list_accounts open_cycles[].cycle_id",
  "cash_flow": "plans start expected; confirm before settle; settle posts the actual amount/time/account to the ledger",
  "owner_panel": "https://console.fiscal.linotsai.top/ (Authenticator login, read-only session)",
  "reimbursements": "one counterparty per claim, one or more expenses with partial amounts; submitted claims become expected inflow; receipts may be partial and post inflow transactions"
}
