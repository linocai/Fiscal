# Environment for one Fiscal MCP process (local stdio or the HZ HTTP gateway).
# Copy this file outside the repository, set real values, chmod 600, and pass
# it to the Agent host. This file deliberately contains placeholders only.

# Point at the backend's versioned API root, including /api/v1.
FISCAL_BACKEND_URL=https://fiscal-staging.example.com/api/v1
FISCAL_BACKEND_TOKEN=CHANGE_ME_CURRENT_FISCAL_ACCESS_KEY
FISCAL_BATCH_API_PATH=/import-batches

# TOTP is the normal Agent authentication path. The secret is the base32 value
# enrolled in the owner's Google Authenticator. It is never shown in discovery
# or the public Agent instructions page.
FISCAL_MCP_TOTP_SECRET=CHANGE_ME_BASE32_TOTP_SECRET
FISCAL_MCP_SESSION_SCOPES=read:reports,read:ledger,stage:imports,export:reports

# Optional legacy bearer key for controlled server-side clients. Do not give it
# to a general Agent. The owner break-glass key is manual-only and grants all
# scopes when the TOTP path is unavailable.
FISCAL_MCP_API_KEY=
FISCAL_MCP_BREAK_GLASS_KEY=CHANGE_ME_OWNER_BREAK_GLASS_KEY_AT_LEAST_16_CHARS
FISCAL_MCP_API_SCOPES=read:reports,read:ledger,stage:imports,export:reports

# This must match the backend's FISCAL_IMPORT_CONFIRMATION_SECRET. It is used
# only inside the gateway to mint the commit confirmation after one TOTP write
# approval; it is never printed or sent to the Web UI.
FISCAL_MCP_CONFIRMATION_SECRET=CHANGE_ME_ONLY_FOR_COMMIT_SCOPE

# Session and approval lifetimes. TOTP rotates every 30 seconds, but an issued
# session remains usable while active. A write approval is single-use.
FISCAL_MCP_SESSION_IDLE_SECONDS=7200
FISCAL_MCP_SESSION_MAX_SECONDS=28800
FISCAL_MCP_OPERATION_SECONDS=1800
FISCAL_MCP_CHALLENGE_SECONDS=600
FISCAL_MCP_APPROVAL_URL=https://console.fiscal.linotsai.top/agent/approve

# Keep mock mode off for staging/production. It is useful for local contract
# work when the backend is not running.
FISCAL_MCP_USE_MOCK=0

# Remote HTTP gateway settings. The process stays on loopback; HZ Nginx owns
# public HTTPS and proxies only the MCP, auth challenge and health routes to
# this port.
FISCAL_MCP_HTTP_PATH=/mcp
FISCAL_MCP_HEALTH_PATH=/health
FISCAL_MCP_BIND_HOST=127.0.0.1
FISCAL_MCP_BIND_PORT=8050
# Comma-separated exact HTTPS origins allowed to call the gateway from a
# browser. Leave empty when only server-side Agent clients use MCP.
FISCAL_MCP_ALLOWED_ORIGINS=
FISCAL_MCP_LOG_LEVEL=info
